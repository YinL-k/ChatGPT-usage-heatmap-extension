{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "3.5.0",
  "version_name": "3.5.0",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "111",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/sakurameter-16.png",
      "32": "assets/sakurameter-32.png",
      "48": "assets/sakurameter-48.png",
      "128": "assets/sakurameter-128.png"
    },
    "default_title": "SakuraMeter"
  },
  "icons": {
    "16": "assets/sakurameter-16.png",
    "32": "assets/sakurameter-32.png",
    "48": "assets/sakurameter-48.png",
    "128": "assets/sakurameter-128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "usage-core.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "default_locale": "en",
  "short_name": "SakuraMeter"
}
